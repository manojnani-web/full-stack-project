# Copy this file to ".env" and edit.

# Local MongoDB (MongoDB Community Server running on your PC):
MONGODB_URI=mongodb://127.0.0.1:27017/shelfmark

# OR MongoDB Atlas (cloud). Paste your own connection string:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shelfmark?retryWrites=true&w=majority

PORT=3000
